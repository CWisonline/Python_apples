"""
Apple tray image analysis

Pipeline:
1. Read all images from data/raw
2. Optional resize (scale_down)
3. Optional crop to a tray region
4. Detect apples via HoughCircles on red channel
5. For each apple:
   - radius/diameter in pixels
   - radius/diameter in mm
   - mean red intensity
6. Save:
   - Overlay PNG per image in data/processed
   - One combined CSV (all images) in data/processed/apples_results.csv
"""

from pathlib import Path
from typing import List, Dict, Optional

import cv2
import numpy as np
import pandas as pd

# ---------------- USER SETTINGS ---------------- #

# Paths are relative to the project root (folder that contains "data/")
PROJECT_ROOT = Path(__file__).resolve().parents[1]
RAW_DIR = PROJECT_ROOT / "data" / "raw"
PROCESSED_DIR = PROJECT_ROOT / "data" / "processed"

# Make sure output directory exists
PROCESSED_DIR.mkdir(parents=True, exist_ok=True)

# Resize factor (same idea as your 0.5 scale in ImageJ)
SCALE_DOWN = 0.5

# ---- Crop rectangle (AFTER scaling) ----
# If you don't want cropping yet, set USE_CROP = False
USE_CROP = True

# These are in pixels after resizing. Replace with your actual values
# from ImageJ (top-left x, top-left y, width, height).
CROP_X = 238   # TODO: update
CROP_Y = 64   # TODO: update
CROP_W = 1842  # TODO: update
CROP_H = 1534  # TODO: update

# ---- Calibration: pixels per mm (AFTER scaling) ----
# Example: if a 1220 mm line measured 800 px at your SCALE_DOWN:
# px_per_mm = 800 / 1220.0
PX_PER_MM = 1712 / 1220.0  # TODO: update from your ImageJ measurement

# ---- Hough circle parameters (tune as needed) ----
# These values are a starting point; you may tweak based on your images.
DP = 1.2          # Inverse accumulator resolution
MIN_DIST = 40     # Minimum distance between circle centres (px)
MIN_RADIUS = 30   # Min radius in pixels (post-scaling/cropping)
MAX_RADIUS = 60   # Max radius in pixels
CANNY_HIGH = 100  # Higher threshold for Canny edge detector
ACCUM_THRESH = 20 # Accumulator threshold for centre detection

# File suffixes to treat as images
IMAGE_SUFFIXES = {".jpg", ".jpeg", ".png", ".tif", ".tiff"}


# ---------------- CORE FUNCTIONS ---------------- #

def list_images(raw_dir: Path) -> List[Path]:
    """Return a sorted list of image files in raw_dir."""
    return sorted(
        p for p in raw_dir.iterdir()
        if p.suffix.lower() in IMAGE_SUFFIXES
    )


def load_and_preprocess(path: Path) -> np.ndarray:
    """
    Load an image, resize by SCALE_DOWN, and optionally crop.

    Returns:
        numpy array (BGR image) ready for further processing.
    """
    img = cv2.imread(str(path), cv2.IMREAD_COLOR)
    if img is None:
        raise RuntimeError(f"Could not read image: {path}")

    # Resize
    img = cv2.resize(
        img,
        dsize=None,
        fx=SCALE_DOWN,
        fy=SCALE_DOWN,
        interpolation=cv2.INTER_AREA,
    )

    # Crop if requested
    if USE_CROP:
        h, w = img.shape[:2]
        x1 = max(0, CROP_X)
        y1 = max(0, CROP_Y)
        x2 = min(w, CROP_X + CROP_W)
        y2 = min(h, CROP_Y + CROP_H)
        img = img[y1:y2, x1:x2].copy()

    return img


def detect_apples_hough(cropped_bgr: np.ndarray) -> Optional[np.ndarray]:
    """
    Detect apples using HoughCircles on the red channel.

    Returns:
        circles: array of shape (N, 3) with (cx, cy, r) as ints,
                 or None if no circles found.
    """
    # BGR -> RGB -> split channels
    rgb = cv2.cvtColor(cropped_bgr, cv2.COLOR_BGR2RGB)
    r_channel, g_channel, b_channel = cv2.split(rgb)

    # Blur red channel to reduce noise
    r_blur = cv2.GaussianBlur(r_channel, (9, 9), 2)

    # HoughCircles expects 8-bit single channel
    circles = cv2.HoughCircles(
        r_blur,
        cv2.HOUGH_GRADIENT,
        dp=DP,
        minDist=MIN_DIST,
        param1=CANNY_HIGH,
        param2=ACCUM_THRESH,
        minRadius=MIN_RADIUS,
        maxRadius=MAX_RADIUS,
    )

    if circles is None:
        return None

    circles = np.round(circles[0, :]).astype(int)  # shape (N, 3)
    return circles


def analyse_apples_for_image(
    img_path: Path,
    apples_bgr: np.ndarray,
    circles: Optional[np.ndarray],
) -> Dict[str, object]:
    """
    Given an image, its cropped BGR data, and detected circles,
    compute per-apple measurements and make an overlay image.

    Returns:
        dict with:
            "rows": list of per-apple result dicts
            "overlay": overlay image (BGR) with circles drawn
    """
    overlay = apples_bgr.copy()
    rows: List[Dict[str, object]] = []

    # Convert BGR -> RGB and get red channel for measuring redness
    rgb = cv2.cvtColor(apples_bgr, cv2.COLOR_BGR2RGB)
    r_channel, g_channel, b_channel = cv2.split(rgb)

    if circles is None or len(circles) == 0:
        # No apples found; still return an empty list (and plain overlay)
        return {
            "rows": [],
            "overlay": overlay,
        }

    n_apples = len(circles)

    h, w = r_channel.shape

    for apple_id, (cx, cy, r) in enumerate(circles, start=1):
        # Skip circles that are clearly off-image (or partly off if you prefer)
        if cx - r < 0 or cy - r < 0 or cx + r >= w or cy + r >= h:
            # You can choose to skip or clamp; here we skip edge-touching apples
            continue

        diameter_px = 2 * r
        # px_per_mm = PX_PER_MM, so mm = px / px_per_mm
        diameter_mm = diameter_px / PX_PER_MM
        radius_mm = r / PX_PER_MM

        # Build mask for this apple on red channel
        mask = np.zeros_like(r_channel, dtype=np.uint8)
        cv2.circle(mask, (cx, cy), r, 255, thickness=-1)

        red_vals = r_channel[mask == 255]
        if red_vals.size > 0:
            mean_red = float(red_vals.mean())
        else:
            mean_red = float("nan")

        # Draw on overlay (circle + centre)
        cv2.circle(overlay, (cx, cy), r, (0, 255, 0), 2)
        cv2.circle(overlay, (cx, cy), 2, (0, 0, 255), -1)

        rows.append(
            {
                "filename": img_path.name,
                "n_apples_in_image": n_apples,
                "apple_number": apple_id,
                "center_x_px": cx,
                "center_y_px": cy,
                "radius_px": r,
                "diameter_px": diameter_px,
                "radius_mm": radius_mm,
                "diameter_mm": diameter_mm,
                "mean_red": mean_red,
            }
        )

    return {
        "rows": rows,
        "overlay": overlay,
    }


# ---------------- MAIN SCRIPT ---------------- #

def main():
    image_paths = list_images(RAW_DIR)
    if not image_paths:
        print(f"No images found in {RAW_DIR}")
        return

    all_rows: List[Dict[str, object]] = []

    print(f"Found {len(image_paths)} images in {RAW_DIR}")
    for img_path in image_paths:
        print(f"\nProcessing: {img_path.name}")

        # 1. Load and preprocess (resize + crop)
        cropped_bgr = load_and_preprocess(img_path)

        # 2. Detect apples via Hough circles
        circles = detect_apples_hough(cropped_bgr)

        if circles is None:
            print("  No apples detected.")
        else:
            print(f"  Detected {len(circles)} candidate apples.")

        # 3. Measure per-apple size + redness; create overlay
        result = analyse_apples_for_image(img_path, cropped_bgr, circles)
        rows = result["rows"]
        overlay = result["overlay"]

        # 4. Append per-apple rows
        all_rows.extend(rows)

        # 5. Save overlay PNG for this image
        overlay_name = img_path.stem + "_processed.png"
        overlay_path = PROCESSED_DIR / overlay_name
        cv2.imwrite(str(overlay_path), overlay)
        print(f"  Saved overlay: {overlay_path.name}")

    # 6. Save combined CSV
    if all_rows:
        df = pd.DataFrame(all_rows)
    else:
        # No apples at all; create empty DF with the desired columns
        df = pd.DataFrame(
            columns=[
                "filename",
                "n_apples_in_image",
                "apple_number",
                "center_x_px",
                "center_y_px",
                "radius_px",
                "diameter_px",
                "radius_mm",
                "diameter_mm",
                "mean_red",
            ]
        )

    csv_path = PROCESSED_DIR / "apples_results.csv"
    df.to_csv(csv_path, index=False)
    print(f"\nWrote CSV with {len(df)} rows to {csv_path}")


if __name__ == "__main__":
    main()
